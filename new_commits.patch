+void OmpPlatformBridge::CallOnDownloadProgress(
+    int playerid,
+    const std::string& fileName,
+    int filePercent,
+    int totalPercent,
+    int fileDownloadedKb,
+    int fileTotalKb,
+    int totalDownloadedKb,
+    int totalKb)
+{
+    if (!pawn_)
+        return;
+
+    auto call = [&](IPawnScript* script) {
+        if (!script)
+            return;
+
+        script->Call(
+            "OnCefDownloadProgress",
+            DefaultReturnValue_True,
+            playerid,
+            StringView(fileName),
+            filePercent,
+            totalPercent,
+            fileDownloadedKb,
+            fileTotalKb,
+            totalDownloadedKb,
+            totalKb);
+    };
+
+    call(pawn_->mainScript());
+    for (IPawnScript* script : pawn_->sideScripts()) {
+        call(script);
+    }
+}
